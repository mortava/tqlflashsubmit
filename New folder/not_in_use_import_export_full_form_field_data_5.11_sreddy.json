import { z } from 'zod';

// Schemas kept permissive for now; adjust required fields as needed later
export const loanInformationSchema = z.object({
  firstMortgageLoanAmountBase: z.coerce.number({ required_error: 'Loan amount is required' }).nonnegative('Must be a positive number').min(1, 'Loan amount must be greater than 0'),
  secondMortgageLoanAmount: z.coerce.number().nonnegative().optional(),
  helocLineAmount: z.coerce.number().nonnegative().optional(),
  helocDrawnAmount: z.coerce.number().nonnegative().optional(),
  loanPurpose: z.enum(['Purchase','Refi Cashout','Refi Rate-Term/Limited C.O.','FHA Streamline Refi','VA Rate Reduction','Simple Refinance'], { required_error: 'Loan purpose is required' }),
  appraisedValue: z.coerce.number({ required_error: 'Appraised value is required' }).nonnegative('Must be a positive number'),
  salesPrice: z.coerce.number({ required_error: 'Sales price is required' }).nonnegative('Must be a positive number'),
  cashOutAmount: z.coerce.number().nonnegative().optional(),
  constructionLoanType: z.enum(['Not Applicable','Construction Only','Construction to Perm']).optional(),
  lotValue: z.coerce.number().nonnegative().optional(),
  costOfImprovements: z.coerce.number().nonnegative().optional(),
  acquisitionCost: z.coerce.number().nonnegative().optional(),
  applicationDate: z.string().optional(),
  disclosureDate: z.string().optional(),
  ltv: z.coerce.number().min(0).max(100).optional(),
  cltv: z.coerce.number().min(0).max(100).optional(),
  dutyToServe: z.enum(['No','Yes']).optional(),
  missionScore: z.enum(['0','1','2','3']).optional(),
});

export const propertyInformationSchema = z.object({
  occupancy: z.enum(['Primary Residence','Second Home','Investment Property'], { required_error: 'Occupancy is required' }),
  propertyType: z.enum([
    'Single Family','Condo','Condotel','Coop','Detached Condo','Manufactured/Double-wide','Manufactured/Single-wide','Modular','Non-Warrantable Condo','PUD','Timeshare','Townhouse'
  ], { required_error: 'Property type is required' }),
  numberOfUnits: z.enum(['1 Unit','2 Units','3 Units','4 Units','5+ Units'], { required_error: 'Number of units is required' }),
  numberOfStories: z.coerce.number().int().min(0, 'Must be at least 0').optional(),
  appraisedValue: z.coerce.number({ required_error: 'Appraised value is required' }).nonnegative('Must be a positive number'),
  salesPrice: z.coerce.number({ required_error: 'Sales price is required' }).nonnegative('Must be a positive number'),
  propertyStreetAddress: z.string().optional(),
  corporateRelocation: z.boolean().optional(),
  propertyZip: z.string().optional(),
  state: z.string({ required_error: 'State is required' }).min(1, 'State is required'),
  county: z.string({ required_error: 'County is required' }).min(1, 'County is required'),
});

export const additionalPricingSchema = z.object({
  desiredRate: z.coerce.number().min(0).max(100).optional(),
  desiredPrice: z.coerce.number().optional(),
  desiredLockTerm: z.coerce.number().optional(),
  interestOnly: z.enum(['No','Yes'], { required_error: 'Interest only is required' }),
  buydown: z.enum(['None','3/2/1','2/1','1/1','1/0'], { required_error: 'Buydown is required' }),
  waiveEscrows: z.enum(['N/A','No','Yes']).optional(),
  automatedUWSystem: z.enum(['Not Specified','DU','LP','Investor AUS','Manual/Traditional'], { required_error: 'Automated U/W System is required' }),
  borrowerPaysMI: z.enum(['Yes','No'], { required_error: 'Borrower pays MI is required' }),
  reducedMI: z.enum(['No','Yes']).optional(),
  includeCompInPricing: z.enum(['No (Buyer Paid)'], { required_error: 'Include comp in pricing is required' }),
  leadSource: z.enum([
    'Option 1 - No Comp','Option 2 - Corporate','Option 3 - Branch','Option 4 - Internet','Option 5 - Connect','Option 6 - Self-Generated Jumbo','Option 7 - Company Generated Jumbo','Option 8 - Self Generated','Option 9 - Trigger','Option 10 - Bigger Pockets','Option 11 - Zillow','Option 12 - Rabbu'
  ]).optional(),
  autoQuoteLeadSource: z.string().optional(),
  autoDebit: z.enum(['No','Yes']).optional(),
  feesIn: z.enum(['No (Fees Out)','Yes (Fees In)']).optional(),
  employeeLoan: z.enum(['No','Yes']).optional(),
  prepaymentPenalty: z.enum(['None','1 Year','2 Year','3 Year','4 Year','5 Year'], { required_error: 'Prepayment penalty is required' }),
  incomeDoc: z.enum(['Verified','Stated w/ IRS Form','Stated w/o IRS Form','None']).optional(),
  assetDoc: z.enum(['Verified','Stated','None']).optional(),
  employDoc: z.enum(['Verified','Stated','None']).optional(),
  communityAffordable2nd: z.enum(['No','Yes']).optional(),
  expAppLevels: z.enum(['N/A','Level 1','Level 2','Level 3','Level 4','Level 5'], { required_error: 'Expanded approval level is required' }),
  searchByEffectiveDateCT: z.string().optional(),
  totalLoanAmount: z.coerce.number().optional(),
  financeEntireAmount: z.boolean().optional(),
  exemptFromFundingFee: z.enum(['No','Yes']).optional(),
  pmiMipFfGFeePercentage: z.coerce.number().optional(),
  pmiMipFfGFeeAmount: z.coerce.number().optional(),
  pmiMipFfGFeePaidInCash: z.coerce.number().optional(),
  pmiMipFfGFeeFinanced: z.coerce.number().optional(),
  subjectMortgageLoanAmountBase: z.coerce.number().optional(),
  subjectMortgageLoanAmountTotal: z.coerce.number().optional(),
  vaVeteranTypeHistory: z.enum([
    'Active Duty - 1st use',
    'Active Duty - Subsequent',
    'Guard/Reserves - 1st use',
    'Guard/Reserves - Subsequent',
  ]).optional(),
  fhaCaseNumberAssigned: z.enum([
    'On or after 1/1/2025',
    'Between 1/1/2024 and 12/31/2024',
    'Between 1/1/2023 and 12/31/2023',
    'Between 1/1/2022 and 12/31/2022',
    'Between 1/1/2021 and 12/31/2021',
    'Between 1/1/2020 and 12/31/2020',
    'Between 9/1/2019 and 12/31/2019',
    'Between 1/1/2019 and 8/31/2019',
    'Between 1/1/2018 and 12/31/2018',
    'Between 1/1/2017 and 12/31/2017',
    'Between 1/1/2016 and 12/31/2016',
    'Between 9/14/2015 and 12/31/2015',
    'Between 1/26/2015 and 9/13/2015',
    'Between 1/1/2015 and 1/25/2015',
    'Between 4/21/2014 and 12/31/2014',
    'Between 1/1/2014 and 4/20/2014',
    'Between 6/3/2013 and 12/31/2013',
    'Between 4/1/2013 and 6/2/2013',
    'Between 1/1/2013 and 3/31/2013',
    'Between 6/11/2012 and 12/31/2012',
    'Between 4/9/2012 and 6/10/2012',
    'Between 1/1/2012 and 4/8/2012',
    'Between 11/18/2011 and 12/31/2011',
    'Between 10/1/2011 and 11/17/2011',
    'Between 4/18/2011 and 9/30/2011',
    'Between 10/4/2010 and 4/17/2011',
    'Between 9/7/2010 and 10/3/2010',
    'Between 4/5/2010 and 9/6/2010',
    'Before 4/5/2010',
    'N/A',
  ]).optional(),
  calculateTotalLoanAmount: z.boolean({ required_error: 'Calculate total loan amount is required' }),
});

export const expandedGuidelinesSchema = z.object({
  mortgageLates30_12: z.coerce.number().int().min(0).optional(),
  mortgageLates60_12: z.coerce.number().int().min(0).optional(),
  mortgageLates90_12: z.coerce.number().int().min(0).optional(),
  mortgageLates120_12: z.coerce.number().int().min(0).optional(),
  mortgageLates30_24: z.coerce.number().int().min(0).optional(),
  mortgageLates60_24: z.coerce.number().int().min(0).optional(),
  mortgageLates90_24: z.coerce.number().int().min(0).optional(),
  mortgageLates120_24: z.coerce.number().int().min(0).optional(),
  incomeVerificationType: z.enum([
    'Full Doc','Personal Bank Stmt: 12 Months','Personal Bank Stmt: 24 Months','Business Bank Stmt: 12 Months','Business Bank Stmt: 24 Months','1 Year Alt Doc','2 Year Alt Doc','Asset Related','Investor - DSCR','Restricted Stock','Investor - No Ratio','Written VOE','1099: 1 Year','1099: 2 Year','P&L: 1 Year','P&L: 2 Year'
  ], { required_error: 'Income verification type is required' }),
  dscr: z.coerce.number({ required_error: 'DSCR is required' }).min(0, 'DSCR must be at least 0'),
  bankruptcyType: z.enum(['None','Chapter 7','Chapter 11','Chapter 13']).optional(),
  bankruptcyOutcome: z.enum(['Not Applicable','Discharged','Dismissed','Open/Pending']).optional(),
  bankruptcySeasoning: z.enum(['Not Applicable']).optional(),
  housingEventType: z.enum(['None','Deed-In-Lieu','Forbearance','Foreclosure','Modification','Short Sale']).optional(),
  housingEventSeasoning: z.enum(['Not Applicable','1 - 12 Months','13 - 24 Months','25 - 36 Months','37 - 48 Months','49 - 60 Months','More than Five Years Ago']).optional(),
  uniqueProperty: z.enum(['No','Yes']).optional(),
  debtConsolidation: z.enum(['No','Yes']).optional(),
  locationCensusTractCode: z.string().optional(),
});

export const customFieldsSchema = z.object({
  fivePlusUnits: z.union([z.enum(['Yes', 'No']), z.literal(''), z.literal('--')]).optional(),
  shortTermRental: z.union([z.enum(['Yes', 'No']), z.literal('')]).optional(),
  vacant: z.union([z.enum(['Yes', 'No']), z.literal('')]).optional(),
  rural: z.union([z.enum(['Yes', 'No']), z.literal('')]).optional(),
  rentalType: z.string().optional(),
  firstTimeInvestor: z.union([z.enum(['Yes', 'No']), z.literal('')]).optional(),
  prepayFeeType: z.string().optional(),
});

export const borrowerInformationSchema = z.object({
  citizenship: z.enum([
    'U.S. Citizen',
    'U.S. Citizen Abroad',
    'Perm. Resident Alien',
    'Non-Perm. Resident Alien',
    'Foreign National',
  ], { required_error: 'Citizenship is required' }),
  firstName: z.string().optional(),
  lastName: z.string().optional(),
  vaFirstTimeUse: z.boolean().optional(),
  firstTimeHomeBuyer: z.boolean().optional(),
  monthsReserves: z.coerce.number({ required_error: 'Months reserves is required' }).int().min(0, 'Must be at least 0'),
  selfEmployed: z.boolean().optional(),
  waiveEscrows: z.boolean().optional(),
  representativeFICO: z.coerce.number({ required_error: 'FICO score is required' }).int().min(300, 'FICO must be at least 300').max(900, 'FICO cannot exceed 900'),
  loanLevelDebtToIncomeRatio: z.coerce.number({ required_error: 'DTI is required' }).min(0, 'DTI must be at least 0').max(100, 'DTI cannot exceed 100'),
  totalMonthlyQualifyingIncome: z.coerce.number().min(0).optional(),
  incomeDocumentation: z.enum(['Verified','Stated w/ IRS Form','Stated w/o IRS Form','None']).optional(),
  assetDocumentation: z.enum(['Verified','Stated','None']).optional(),
  employmentDocumentation: z.enum(['Verified','Stated','None']).optional(),
});

export const productFiltersSchema = z.object({
  lienPosition: z.enum(['First Lien','Second Lien','HELOC First Lien','HELOC Second Lien'], { required_error: 'Lien position is required' }),
  loanType: z.enum(['Conforming','NonConforming','FHA','VA','Alt-A/Exp. Crit.','USDA'], { required_error: 'Loan type is required' }),
  loanTerms: z.array(z.enum(['40 Years','30 Years','25 Years','20 Years','15 Years','12 Years','10 Years','9 Years','8 Years','7 Years','6 Years','5 Years','4 Years','3 Years','2 Years','1 Year','9 Months','6 Months','3 Months','Non-Standard'])).min(1, 'At least one loan term must be selected'),
  amortizationTypes: z.enum(['Fixed','ARM','Balloon'], { required_error: 'Amortization type is required' }),
  armFixedTerms: z.array(z.enum(['15 Years','10 Years','7 Years','6 Years','5 Years','3 Years'])).optional(),
  productFilters: z.enum(['Standard','Affordable','HARP','Hero/Champion','HFA/Bond','HUD Specialty','Renovation/Rehab','Student Loan Cash Out Refi','USDA Streamline','Expanded Guidelines']).optional(),
  searchType: z.enum(['Buy-Side Search','Sell-Side Search','Consumer Quick Quote','Consumer Rate Alert','Lead Mgt Auto-Quote']).optional(),
});

export const obFormSchema = z.object({
  borrowerInformation: borrowerInformationSchema,
  productFilters: productFiltersSchema,
  loanInformation: loanInformationSchema,
  propertyInformation: propertyInformationSchema,
  additionalPricing: additionalPricingSchema,
  expandedGuidelines: expandedGuidelinesSchema,
  customFields: customFieldsSchema,
});

export type OBFormData = z.infer<typeof obFormSchema>;

